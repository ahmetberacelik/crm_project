# Spring Boot Profile
# Hangi application-{profile}.properties dosyasının aktif olacağını belirler. Geliştirme için 'dev'.
SPRING_PROFILES_ACTIVE=dev

# Server Configuration
# Servis portları
GATEWAY_PORT=8080
USER_SERVER_PORT=8081
DEPARTMENT_SERVER_PORT=8082
TICKET_SERVER_PORT=8083

DEPARTMENT_SERVICE_URL="http://department-service:${DEPARTMENT_SERVER_PORT}"
TICKET_SERVICE_URL="http://ticket-service:${TICKET_SERVER_PORT}"

# Database Configuration (for Docker Compose & Application)
# Bu değişkenler hem docker-compose.yml tarafından MSSQL konteynerini başlatmak için,
# hem de application-dev.properties tarafından veritabanına bağlanmak için kullanılacak.
DB_HOST=mssql-db
DB_PORT=1433
DB_NAME=crm_db
DB_USER=sa
MSSQL_SA_PASSWORD=change_me_strong_password

# R2DBC URL for Spring Boot application
# Spring'in reaktif MSSQL sürücüsü için tam bağlantı dizesi.
R2DBC_URL="r2dbc:mssql://${DB_HOST}:${DB_PORT}/${DB_NAME}"

# JWT Configuration
# Access token gizli anahtarı ve süresi (ms). Test için 60 sn.
JWT_SECRET=change_me_long_random_secret
JWT_EXPIRATION_MS=900000

# Refresh Token Configuration
# Refresh token geçerlilik süresi (gün)
REFRESH_TOKEN_TTL_DAYS=7