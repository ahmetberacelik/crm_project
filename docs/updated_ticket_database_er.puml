@startuml UpdatedTicketDatabaseER
!theme plain
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 9

skinparam entity {
  BackgroundColor<<Customers>> lightblue
  BackgroundColor<<Pools>> lightgray
  BackgroundColor<<Users>> lightgreen
  BackgroundColor<<Support_Tickets>> yellow
  BackgroundColor<<Ticket_History>> orange
  BackgroundColor<<Notifications>> plum
  BorderColor black
  FontSize 9
}

entity "Customers" as customers <<Customers>> {
  + customer_id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  name : VARCHAR(255) <<NOT NULL>>
  email : VARCHAR(255)
  phone : VARCHAR(20)
  created_at : DATETIME <<DEFAULT CURRENT_TIMESTAMP>>
}

entity "Pools" as pools <<Pools>> {
  + pool_id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  name : VARCHAR(255) <<NOT NULL>>
  department : VARCHAR(50) <<NOT NULL>>
}

entity "Users" as users <<Users>> {
  + user_id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  name : VARCHAR(255) <<NOT NULL>>
  department : VARCHAR(50) <<NOT NULL>>
  expertise_level : VARCHAR(50)
}

entity "Support_Tickets" as tickets <<Support_Tickets>> {
  + ticket_id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  # customer_id : BIGINT <<FK>>
  issue : TEXT <<NOT NULL>>
  category : VARCHAR(100)
  priority : VARCHAR(50) <<DEFAULT 'Orta'>>
  status : VARCHAR(50) <<DEFAULT 'Açık'>>
  # pool_id : BIGINT <<FK>>
  # assigned_to : BIGINT <<FK, NULLABLE>>
  created_at : DATETIME <<DEFAULT CURRENT_TIMESTAMP>>
}

entity "Ticket_History" as history <<Ticket_History>> {
  + history_id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  # ticket_id : BIGINT <<FK>>
  # previous_pool_id : BIGINT <<FK>>
  # new_pool_id : BIGINT <<FK>>
  # previous_assigned_to : BIGINT <<FK, NULLABLE>>
  # new_assigned_to : BIGINT <<FK, NULLABLE>>
  reason : TEXT
  changed_at : DATETIME <<DEFAULT CURRENT_TIMESTAMP>>
}

entity "Notifications" as notifications <<Notifications>> {
  + notification_id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  # ticket_id : BIGINT <<FK>>
  message : TEXT
  sent_to : VARCHAR(255)
  created_at : DATETIME <<DEFAULT CURRENT_TIMESTAMP>>
}

' İlişkiler
customers ||--o{ tickets : "1:N\ncustomer_id"
pools ||--o{ tickets : "1:N\npool_id"
users ||--o{ tickets : "1:N\nassigned_to"
tickets ||--o{ history : "1:N\nticket_id"
tickets ||--o{ notifications : "1:N\nticket_id"
pools ||--o{ history : "1:N\nprevious_pool_id"
pools ||--o{ history : "1:N\nnew_pool_id"
users ||--o{ history : "1:N\nprevious_assigned_to"
users ||--o{ history : "1:N\nnew_assigned_to"

note top of customers #lightblue
  **CUSTOMERS**
  Müşteri bilgilerini saklar.
  + Telefon numarası eklendi
  Her müşteri birden fazla 
  ticket açabilir.
end note

note top of pools #lightgray
  **POOLS**
  Sadece departman havuzları:
  • BT Havuzu
  • Finans Havuzu  
  • İK Havuzu
  • Müşteri Destek Havuzu
end note

note top of users #lightgreen
  **USERS**
  Şirket yetkilileri:
  • Junior/Senior seviye
  • Departman bazlı
  • Ticket atama hedefi
  • Çoklu departman desteği
end note

note bottom of tickets #yellow
  **SUPPORT_TICKETS**
  Ana iş birimi. Doğrudan
  departman havuzuna atanır.
  Çoklu departman workflow
  desteği ile güçlendirildi.
end note

note bottom of history #orange
  **TICKET_HISTORY**
  • Yeniden yönlendirme geçmişi
  • Departmanlar arası geçişler
  • Yanlış atama düzeltmeleri
  • Tam audit trail desteği
end note

note bottom of notifications #plum
  **NOTIFICATIONS** 
  Tüm bildirim kayıtları:
  • E-posta bildirimleri
  • Telefon bildirimleri
  • Yetkili bildirimleri
  • Durum değişiklikleri
end note

note right
  **Renk Kodları:**
  🔵 Mavi: Müşteri verileri
  ⚪ Gri: Departman havuzları
  🟢 Yeşil: Yetkililer
  🟡 Sarı: Ana iş birimi
  🟠 Turuncu: Geçmiş takibi
  🟣 Mor: Bildirimler
  
  **Anahtar Notasyonlar:**
  + : Primary Key (PK)
  # : Foreign Key (FK)
  -- : Ayırıcı çizgi
  
  **Yeni Workflow Özellikleri:**
  • Doğrudan departman atama
  • Departmanlar arası yönlendirme
  • Çoklu bildirim kanalları
  • Kapsamlı audit trail
end note

@enduml 