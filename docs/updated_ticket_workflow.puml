@startuml UpdatedTicketWorkflow
!theme plain
skinparam backgroundColor white
skinparam defaultFontName Arial

start

:Müşteri Ticket Oluşturur
Form Doldurur: Sorun açıklaması, 
Kategori seçimi, Aciliyet;
note right #yellow : Bildirim

:Müşteriye Bildirim:
"Ticket'ınız alındı";
note right #yellow : Bildirim

:Kategorizasyon
(Anahtar kelime taraması/AI);
note right #orange : Karar Noktası

if (Hangi Kategori?) then (Yazılım Hatası)
  :Kategori: Yazılım Hatası;
  note left #lightblue : BT Kategorisi
elseif (Fatura Sorunu) then 
  :Kategori: Fatura Sorunu;
  note left #lightgreen : Finans Kategorisi
elseif (İK Talebi) then
  :Kategori: İK Talebi;
  note left #lightcoral : İK Kategorisi
else (Genel)
  :Kategori: Genel;
  note left #lightgray : Müşteri Destek
endif

:Önceliklendirme;
note right #orange : Karar Noktası

if (Acil/Çökme?) then (Evet)
  :Öncelik: ACIL;
elseif (Yüksek?) then (Evet)
  :Öncelik: YÜKSEK;
elseif (Orta?) then (Evet)
  :Öncelik: ORTA;
else (Düşük)
  :Öncelik: DÜŞÜK;
endif

:Departman Havuzuna Atama;
note right #orange : Karar Noktası

if (Hangi Departman?) then (BT)
  :BT Havuzuna Atandı;
  note left #lightblue : BT Havuzu
elseif (Finans) then
  :Finans Havuzuna Atandı;
  note left #lightgreen : Finans Havuzu
elseif (İK) then
  :İK Havuzuna Atandı;
  note left #lightcoral : İK Havuzu
else (Müşteri Destek)
  :Müşteri Destek Havuzuna Atandı;
  note left #lightgray : Müşteri Destek
endif

:Yetkiliye Atama;
note right #orange : Karar Noktası

if (Öncelik Yüksek?) then (Evet)
  :Senior Yetkiliye Atandı;
else (Hayır)
  :Junior Yetkiliye Atandı;
endif

:Yetkiliye Bildirim:
"Yeni ticket atandı";
note right #yellow : Bildirim

:Yetkili Ticket'ı İnceler;

if (Atama Doğru mu?) then (Hayır)
  :Yanlış Atama Tespit Edildi;
  note right #red : Hata Durumu
  :Yeniden Kategorize Et;
  note right #orange : Kategorizasyon'a Dön
  stop
else (Evet)
  :Doğru Atama - İşe Başla;
endif

:Yetkili Kendi Kısmını Çözer;
note right #orange : Departman İşi

if (Birden Fazla Departman 
Gerekiyor mu?) then (Evet)
  :Kendi İşi Tamamlandı;
  note right #green : Kısmi Çözüm
  
  :Diğer Departmana Yönlendir;
  note right #purple : Departmanlar Arası Geçiş
  
  if (Hangi Departmana?) then (BT → Finans)
    :Finans Havuzuna Yönlendir;
    note right #lightgreen : BT'den Finans'a
  elseif (Finans → BT) then
    :BT Havuzuna Yönlendir;
    note right #lightblue : Finans'tan BT'ye
  elseif (→ İK) then
    :İK Havuzuna Yönlendir;
    note right #lightcoral : İK'ya Yönlendir
  else (→ Müşteri Destek)
    :Müşteri Destek Havuzuna Yönlendir;
    note right #lightgray : Müşteri Desteğe
  endif
  
  :Bildirim: "Ticket başka 
  departmana yönlendirildi";
  note right #yellow : Bildirim
  
  :Yeni Departmanda
  Yetkiliye Atama;
  note right #orange : Tekrar Atama
  
  :Yeni Yetkili İşini Çözer;
  
else (Hayır)
  :Tek Departman - İş Tamamlandı;
endif

:Ticket Durumu: "KAPALI";

:Müşteriye Çözüm Bildirimi:
"Sorununuz çözüldü, 
lütfen kontrol edin";
note right #yellow : Bildirim

:Müşteri Geri Bildirimi
(5 yıldız memnuniyet anketi);
note right #yellow : Bildirim

stop

note right
  **Renk Kodları:**
  🔵 Mavi: BT Departmanı
  🟢 Yeşil: Finans Departmanı  
  🔴 Kırmızı: İK Departmanı
  ⚪ Gri: Müşteri Destek
  🟡 Sarı: Bildirimler
  🟠 Turuncu: Karar Noktaları
  🟣 Mor: Departmanlar Arası Geçiş
  
  **Yeni Özellikler:**
  ❌ Ortak Havuz Kaldırıldı
  ✅ Doğrudan Departman Atama
  🔄 Departmanlar Arası Yönlendirme
  📝 Her Adımda Bildirim
  
  **Örnek Senaryo:**
  Ali Veli: "Raporlama modülü çöküyor, 
  fatura verileri eksik"
  → Yazılım Hatası → Acil → BT Havuzu 
  → Senior Ayşe → Yazılım düzeltildi
  → Finans gerekli → Finans Havuzu 
  → Mehmet → Fatura düzeltildi → Kapalı
  → 5 yıldız geri bildirim
end note

@enduml 